# Copy to .env and fill in. Never commit .env.
# The DATABASE_URL below matches the LOCAL-DEV-ONLY placeholder credentials in
# docker-compose.yml (Postgres bound to 127.0.0.1). Use your own for anything else.
DATABASE_URL=postgresql://atx:atx@localhost:5432/atx_civic
SOCRATA_DOMAIN=data.austintexas.gov
# Free app token (Developer Settings on the portal) — needed for scheduled polling.
SOCRATA_APP_TOKEN=
