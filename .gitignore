# --- Secrets / environment / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.netrc
.pgpass
credentials*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# --- Node / frontend build output ---
node_modules/
frontend/dist/

# --- Generated data (never committed; produced from your own database) ---
# Static dashboard snapshots baked by scripts/export_static.py
frontend/public/data/
# Story markdown produced by scripts/export_stories.py
docs/stories/
# Findings produced by scripts/analyze_*.py
docs/str-gap-findings.md
docs/money-wins-findings.md
# Bulk source data (TCAD exports, Inside Airbnb CSVs, deed files, dumps).
# (data/* not data/ — files under an excluded DIRECTORY can't be re-included)
data/*
# ...except the hand-curated, source-cited ballot crosswalk
!data/ballot_crosswalk.csv
*.dump
*.sql.gz
*.parquet
*.zip
*.tar
*.tar.gz
*.tgz

# --- Local tooling / agent / tracker state (never part of this repo) ---
.claude/
.pi/
.superpowers/
.beads/
.deepeval/
.codex/
*.darc

# --- Test / tooling caches ---
